    given-names: Hanyu
    affiliation: "Nanyang Technological University"
  - family-names: Feng
    given-names: Lixue
    affiliation: "Nanfang Hospital, Southern Medical University"
repository-code: "https://github.com/HanyuYang2026/blood-based-lymphoma-detection-machine-learning"
keywords:
  - machine learning
  - lymphoma detection
  - logistic regression
  - ROC analysis
  - cross-validation
